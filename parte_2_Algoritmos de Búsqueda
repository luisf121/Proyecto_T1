# Lista de 15 pedidos ordenados por código
pedidos = [
    {
        "codigo": f"P{i:05d}",
        "cliente": f"Cliente {i}",
        "ciudad": ["Lima", "Cusco", "Arequipa"][(i - 1) % 3],
        "peso": float(i + 2),
        "prioridad": ["Alta", "Media", "Baja"][(i - 1) % 3],
        "costo": float(15 + i * 2)
    }
    for i in range(1, 16)
]


# 1. BÚSQUEDA LINEAL
def busqueda_lineal(pedidos, codigo):
    comparaciones = 0

    for pedido in pedidos:
        comparaciones += 1

        if pedido["codigo"] == codigo:
            return pedido, comparaciones

    return None, comparaciones
